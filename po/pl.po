#. Translators: {option} is the command-line option --timezone
#: gpxfoto/cli.py:25
#, python-brace-format
msgid "time zone from {option}"
msgstr "strefa czasowa z opcji {option}"

#: gpxfoto/cli.py:26
msgid "computer’s time zone (not in EXIF)"
msgstr "strefa czasowa komputera (brak w EXIF)"

#: gpxfoto/cli.py:33
msgid "usage: "
msgstr "użycie: "

#: gpxfoto/cli.py:34
#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s:"

#: gpxfoto/cli.py:35
msgid "positional arguments"
msgstr "argumenty pozycyjne"

#: gpxfoto/cli.py:36
msgid "options"
msgstr "opcje"

#: gpxfoto/cli.py:37
msgid "show this help message and exit"
msgstr "wyświetla ten komunikat pomocy i kończy działanie"

#: gpxfoto/cli.py:38
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s: błąd: %(message)s\n"

#: gpxfoto/cli.py:39
#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "argument %(argument_name)s: %(message)s"

#: gpxfoto/cli.py:40
#, python-format
msgid "the following arguments are required: %s"
msgstr "wymagane są następujące argumenty: %s"

#: gpxfoto/cli.py:41
#, python-format
msgid "unrecognized arguments: %s"
msgstr "nierozpoznane argumenty: %s"

#: gpxfoto/cli.py:42
#, python-format
msgid "ignored explicit argument %r"
msgstr "zignorowano jawnie podany argument %r"

#: gpxfoto/cli.py:43
msgid "expected one argument"
msgstr "oczekiwano jednego argumentu"

#: gpxfoto/cli.py:44
#, python-format
msgid "invalid %(type)s value: %(value)r"
msgstr "nieprawidłowa wartość typu %(type)s: %(value)r"

#: gpxfoto/cli.py:60
#, python-brace-format
msgid "not a valid number of seconds: {value}"
msgstr "nieprawidłowa liczba sekund: {value}"

#: gpxfoto/cli.py:67
#, python-brace-format
msgid "must not be negative: {value}"
msgstr "wartość nie może być ujemna: {value}"

#. Translators: date and time of a track point as a strftime format. %x
#. and %X follow the system's regional settings; replace them only if
#. those are wrong for your language, as they are for Polish on macOS
#. (%-d is the day without a leading zero).
#: gpxfoto/cli.py:92
#, no-python-format
msgid "%x %X"
msgstr "%-d.%m.%Y %H:%M:%S"

#: gpxfoto/cli.py:121
msgid ""
"Adds locations from GPX tracks to photos without changing the image "
"data."
msgstr ""
"Dopisuje do zdjęć położenie na podstawie tras GPX, nie zmieniając "
"danych obrazu."

#. Translators: placeholder for arguments in the usage line of --help;
#. keep it a single word
#: gpxfoto/cli.py:125
msgid "PHOTO"
msgstr "ZDJĘCIE"

#: gpxfoto/cli.py:126
msgid "JPEG files or directories with photos"
msgstr "pliki JPEG lub katalogi ze zdjęciami"

#. Translators: placeholder for a file name in --help; keep it a single word
#: gpxfoto/cli.py:128 gpxfoto/cli.py:140
msgid "FILE"
msgstr "PLIK"

#: gpxfoto/cli.py:129
msgid "GPX file with the track (can be given more than once)"
msgstr "plik GPX z trasą (można podać wielokrotnie)"

#: gpxfoto/cli.py:131
msgid ""
"write the locations to the files (without this option only a preview "
"is shown)"
msgstr ""
"zapisuje położenie w plikach (bez tej opcji wyświetlany jest tylko "
"podgląd)"

#. Translators: placeholder for a number in --help; keep it a single word
#: gpxfoto/cli.py:134 gpxfoto/cli.py:150
msgid "SECONDS"
msgstr "SEKUNDY"

#: gpxfoto/cli.py:135
msgid "camera clock correction in seconds, added to the capture time"
msgstr ""
"poprawka zegara aparatu w sekundach, dodawana do czasu wykonania "
"zdjęcia"

#. Translators: placeholder in --help; HH stands for hours, MM for minutes
#: gpxfoto/cli.py:137
msgid "+HH:MM"
msgstr "+GG:MM"

#: gpxfoto/cli.py:138
msgid ""
"camera time zone for all photos (default: read from each photo’s EXIF "
"data)"
msgstr ""
"strefa czasowa aparatu dla wszystkich zdjęć (domyślnie: odczytywana z "
"danych EXIF każdego zdjęcia)"

#: gpxfoto/cli.py:141
#, python-brace-format
msgid ""
"photo of an accurate clock, such as the watch that records the track, "
"for working out the camera clock correction (with {option})"
msgstr ""
"zdjęcie dokładnego zegara, na przykład zegarka zapisującego trasę, "
"służące do wyznaczenia poprawki zegara aparatu (razem z opcją "
"{option})"

#. Translators: placeholder for a time in --help; keep it a single word
#: gpxfoto/cli.py:145
msgid "TIME"
msgstr "CZAS"

#: gpxfoto/cli.py:146
#, python-brace-format
msgid ""
"time shown on the clock in the {option} photo, 24-hour, for example "
"14:03:27, 14:03:27+02:00 or 2026-10-06T14:03:27+02:00"
msgstr ""
"czas widoczny na zegarze na zdjęciu podanym w opcji {option}, w "
"formacie 24-godzinnym, na przykład 14:03:27, 14:03:27+02:00 lub "
"2026-10-06T14:03:27+02:00"

#: gpxfoto/cli.py:151
#, python-brace-format
msgid ""
"largest allowed time between a photo and the nearest track point "
"(default: {seconds} s)"
msgstr ""
"największy dopuszczalny odstęp czasu między zdjęciem a najbliższym "
"punktem trasy (domyślnie: {seconds} s)"

#: gpxfoto/cli.py:154
msgid "also change photos that already have a location"
msgstr "zmienia także zdjęcia, które mają już zapisane położenie"

#: gpxfoto/cli.py:157
#, python-brace-format
msgid ""
"keep copies of the original files in a “{directory}” subdirectory "
"next to each photo; an existing copy is never replaced"
msgstr ""
"zachowuje kopie oryginalnych plików w podkatalogu „{directory}” obok "
"każdego zdjęcia; istniejąca kopia nigdy nie jest zastępowana"

#: gpxfoto/cli.py:161
msgid "also look for photos in subdirectories"
msgstr "wyszukuje zdjęcia także w podkatalogach"

#. Translators: a note on the line of a photo; {zone} is a UTC offset
#. such as +02:00
#: gpxfoto/cli.py:170
#, python-brace-format
msgid "camera’s UTC time suggests {zone}"
msgstr "czas UTC z aparatu wskazuje strefę {zone}"

#. Translators: a note on the line of a photo; {duration} is a time span
#. such as “10 min”
#: gpxfoto/cli.py:174
#, python-brace-format
msgid "differs by {duration} from the camera’s UTC time"
msgstr "różni się o {duration} od czasu UTC z aparatu"

#. Translators: shown after the file name of a photo; {reason} says
#. why the photo was skipped, e.g. “already has a location”
#: gpxfoto/cli.py:191
#, python-brace-format
msgid "skipped: {reason}"
msgstr "pominięte: {reason}"

#. Translators: elevation in metres
#: gpxfoto/cli.py:196
#, python-brace-format
msgid "{elevation} m"
msgstr "{elevation} m"

#. Translators: {correction} is a time span with a sign, such as
#. “+2 min 12 s”; {option} is the same as a command-line option, such as
#. “--offset=132”
#: gpxfoto/cli.py:207
#, python-brace-format
msgid "Clock correction: {correction} (equivalent to {option})"
msgstr "Poprawka zegara: {correction} (odpowiada opcji {option})"

#. Translators: a UTC offset as shown to the user; {offset} is, for
#. example, “+02:00”
#: gpxfoto/cli.py:214
#, python-brace-format
msgid "UTC{offset}"
msgstr "UTC{offset}"

#. Translators: {name} is the file name of the clock photo; {camera} and
#. {clock} are the date and time the camera and the clock showed
#: gpxfoto/cli.py:219
#, python-brace-format
msgid "Clock photo {name}: camera {camera}, clock {clock}"
msgstr "Zdjęcie zegara {name}: aparat {camera}, zegar {clock}"

#: gpxfoto/cli.py:226
msgid ""
"The time on the clock was given without seconds, so the middle of the "
"minute was used; the correction may be off by up to 30 s."
msgstr ""
"Czas na zegarze podano bez sekund, więc przyjęto środek minuty; "
"poprawka może się różnić od właściwej o najwyżej 30 s."

#. Translators: {option} and {other} are command-line options
#: gpxfoto/cli.py:239
#, python-brace-format
msgid "{option} must be used together with {other}"
msgstr "opcji {option} należy użyć razem z opcją {other}"

#. Translators: {option} and {other} are command-line options
#: gpxfoto/cli.py:243
#, python-brace-format
msgid "{option} cannot be used together with {other}"
msgstr "opcji {option} nie można użyć razem z opcją {other}"

#: gpxfoto/cli.py:247
#, python-brace-format
msgid "exiftool is not installed. On Fedora, install it with: {command}"
msgstr ""
"Program exiftool nie jest zainstalowany. W systemie Fedora można go "
"zainstalować poleceniem: {command}"

#: gpxfoto/cli.py:256
msgid ""
"The time zone must be in the form +HH:MM, for example +02:00 or "
"-05:00."
msgstr ""
"Strefę czasową należy podać w postaci +GG:MM, na przykład +02:00 lub "
"-05:00."

#: gpxfoto/cli.py:270
msgid "The GPX file contains no track points with timestamps."
msgid_plural "The GPX files contain no track points with timestamps."
msgstr[0] "Plik GPX nie zawiera punktów trasy ze znacznikami czasu."
msgstr[1] "Pliki GPX nie zawierają punktów trasy ze znacznikami czasu."
msgstr[2] "Pliki GPX nie zawierają punktów trasy ze znacznikami czasu."

#. Translators: {start} and {end} are the date and time of the first and the
#. last track point
#: gpxfoto/cli.py:277
#, python-brace-format
msgid "Track: {count} point, {start} – {end} (this computer’s time zone)"
msgid_plural "Track: {count} points, {start} – {end} (this computer’s time zone)"
msgstr[0] "Trasa: {count} punkt, {start} – {end} (strefa czasowa komputera)"
msgstr[1] "Trasa: {count} punkty, {start} – {end} (strefa czasowa komputera)"
msgstr[2] "Trasa: {count} punktów, {start} – {end} (strefa czasowa komputera)"

#. Translators: {correction} is a time span with a sign, such as
#. “+2 min 12 s”, added to the capture time of every photo
#: gpxfoto/cli.py:286
#, python-brace-format
msgid "Clock correction: {correction}"
msgstr "Poprawka zegara: {correction}"

#: gpxfoto/cli.py:294
msgid "No JPEG photos found."
msgstr "Nie znaleziono zdjęć JPEG."

#: gpxfoto/cli.py:316
#, python-brace-format
msgid "Matched: {matched}, skipped: {skipped}"
msgstr "Dopasowano: {matched}, pominięto: {skipped}"

#. Translators: {option} is the command-line option --write
#: gpxfoto/cli.py:321
#, python-brace-format
msgid ""
"This was a preview; no files were changed. Use {option} to write the "
"locations."
msgstr ""
"To był podgląd, nie zmieniono żadnych plików. Aby zapisać położenie, "
"należy użyć opcji {option}."

#: gpxfoto/cli.py:335
#, python-brace-format
msgid "Could not write {name}: {error} (file unchanged)"
msgstr "Nie można zapisać pliku {name}: {error} (plik bez zmian)"

#: gpxfoto/cli.py:337
#, python-brace-format
msgid "Written: {written}, errors: {errors}"
msgstr "Zapisano: {written}, błędy: {errors}"

#: gpxfoto/cli.py:340
msgid "The image data of every written file was verified as unchanged."
msgstr ""
"Sprawdzono, że dane obrazu w każdym zapisanym pliku pozostały bez "
"zmian."

#. Translators: {value} is what the user gave as the time on the clock;
#. HH:MM:SS and HH:MM stand for hours, minutes and seconds
#: gpxfoto/engine/clock.py:96
#, python-brace-format
msgid ""
"not a valid time: {value} (use HH:MM:SS or HH:MM, optionally with a "
"date and a UTC offset, for example 14:03:27, 2026-10-06T14:03:27 or "
"14:03:27+02:00)"
msgstr ""
"nieprawidłowy czas: {value} (należy podać GG:MM:SS lub GG:MM, "
"opcjonalnie z datą i przesunięciem względem UTC, na przykład "
"14:03:27, 2026-10-06T14:03:27 lub 14:03:27+02:00)"

#. Translators: {value} is the time on the clock given by the user
#: gpxfoto/engine/clock.py:133
#, python-brace-format
msgid "The time on the clock is out of range: {value}"
msgstr "Czas na zegarze wykracza poza dopuszczalny zakres: {value}"

#: gpxfoto/engine/clock.py:144
#, python-brace-format
msgid ""
"The time on the clock is {duration} away from the capture time of the "
"clock photo, so the clock may have shown a different time zone than "
"the camera. Add the UTC offset of the time on the clock, for example "
"“{near}” or “{same}”."
msgstr ""
"Czas na zegarze różni się od czasu wykonania zdjęcia zegara o "
"{duration}, więc zegar mógł pokazywać czas innej strefy czasowej niż "
"aparat. Należy dopisać przesunięcie względem UTC czasu na zegarze, na "
"przykład „{near}” lub „{same}”."

#: gpxfoto/engine/clock.py:151
#, python-brace-format
msgid ""
"The time on the clock is {duration} away from the capture time of the "
"clock photo. Add the UTC offset of the time on the clock as well, for "
"example “{same}”."
msgstr ""
"Czas na zegarze różni się od czasu wykonania zdjęcia zegara o "
"{duration}. Należy dopisać także przesunięcie względem UTC czasu na "
"zegarze, na przykład „{same}”."

#. Translators: a form of a date, shown to the user in an example of
#. the time on the clock; Y is a digit of the year, M of the month and
#. D of the day
#: gpxfoto/engine/clock.py:158
msgid "YYYY-MM-DD"
msgstr "RRRR-MM-DD"

#: gpxfoto/engine/clock.py:162
#, python-brace-format
msgid ""
"The time on the clock is {duration} away from the capture time of the "
"clock photo. If the camera’s clock really is that far off, give the "
"date shown on the clock as well, in the form “{form}”."
msgstr ""
"Czas na zegarze różni się od czasu wykonania zdjęcia zegara o "
"{duration}. Jeśli zegar aparatu rzeczywiście tak bardzo się myli, "
"należy podać także datę widoczną na zegarze w postaci „{form}”."

#: gpxfoto/engine/clock.py:176
msgid "no such file or directory"
msgstr "nie ma takiego pliku ani katalogu"

#: gpxfoto/engine/clock.py:178
msgid "not a regular file"
msgstr "nie jest zwykłym plikiem"

#. Translators: {path} is the file given as the clock photo; {reason} says
#. what is wrong with it
#: gpxfoto/engine/clock.py:190
#, python-brace-format
msgid "Cannot use the clock photo {path}: {reason}"
msgstr "Nie można użyć zdjęcia zegara {path}: {reason}"

#. Translators: reason why a photo was skipped
#: gpxfoto/engine/matching.py:29
msgid "already has a location"
msgstr "ma już zapisane położenie"

#. Translators: reason why a photo was skipped
#: gpxfoto/engine/matching.py:41
msgid "the corrected capture time is out of range"
msgstr "poprawiony czas wykonania wykracza poza dopuszczalny zakres"

#: gpxfoto/engine/photos.py:74
#, python-brace-format
msgid "No such file or directory: {path}"
msgstr "Nie ma takiego pliku ani katalogu: {path}"

#: gpxfoto/engine/photos.py:83
#, python-brace-format
msgid ""
"exiftool does not work:\n"
"{errors}"
msgstr ""
"Program exiftool nie działa:\n"
"{errors}"

#: gpxfoto/engine/photos.py:116
msgid "exiftool returned data that cannot be read"
msgstr "Program exiftool zwrócił dane, których nie można odczytać"

#: gpxfoto/engine/photos.py:134
msgid "exiftool could not read the file"
msgstr "program exiftool nie mógł odczytać pliku"

#. Translators: reason why a photo was skipped; {error} comes from exiftool
#: gpxfoto/engine/photos.py:268
#, python-brace-format
msgid "cannot be read: {error}"
msgstr "nie można odczytać pliku: {error}"

#. Translators: reason why a photo was skipped
#: gpxfoto/engine/photos.py:270
msgid "no capture time in EXIF"
msgstr "brak daty wykonania w EXIF"

#. Translators: reason why a photo was skipped; {value} is the text found
#: gpxfoto/engine/photos.py:282
#, python-brace-format
msgid "invalid capture time in EXIF: {value}"
msgstr "nieprawidłowa data wykonania w EXIF: {value}"

#. Translators: {error} describes the problem, e.g. “No such file or directory”
#: gpxfoto/engine/track.py:92
#, python-brace-format
msgid "Cannot read the GPX file {path}: {error}"
msgstr "Nie można odczytać pliku GPX {path}: {error}"

#. Translators: reason why a photo was skipped; {duration} is
#. a time span such as “10 min”
#: gpxfoto/engine/track.py:162
#, python-brace-format
msgid "{duration} before the start of the track"
msgstr "{duration} przed początkiem trasy"

#. Translators: reason why a photo was skipped; {duration} is
#. a time span such as “10 min”
#: gpxfoto/engine/track.py:166
#, python-brace-format
msgid "{duration} after the end of the track"
msgstr "{duration} po zakończeniu trasy"

#. Translators: reason why a photo was skipped; {duration} is a time
#. span such as “10 min”
#: gpxfoto/engine/track.py:176
#, python-brace-format
msgid "gap in the track recording, nearest point {duration} away"
msgstr "przerwa w zapisie trasy, najbliższy punkt oddalony o {duration}"

#: gpxfoto/engine/writer.py:38
msgid "not a JPEG file"
msgstr "to nie jest plik JPEG"

#: gpxfoto/engine/writer.py:42 gpxfoto/engine/writer.py:55
#: gpxfoto/engine/writer.py:58
msgid "damaged JPEG structure"
msgstr "uszkodzona struktura JPEG"

#: gpxfoto/engine/writer.py:79
#, python-brace-format
msgid "invalid location: {location}"
msgstr "nieprawidłowe położenie: {location}"

#: gpxfoto/engine/writer.py:83
msgid "this file is a backup copy made by gpxfoto, which is never changed"
msgstr ""
"ten plik jest kopią zapasową utworzoną przez gpxfoto, która nigdy nie "
"jest zmieniana"

#: gpxfoto/engine/writer.py:89
msgid "the file has several hard links; writing it would separate them"
msgstr "plik ma kilka dowiązań twardych; zapis by je rozdzielił"

#: gpxfoto/engine/writer.py:91 gpxfoto/engine/writer.py:133
msgid "another program changed the photo in the meantime"
msgstr "inny program zmienił w międzyczasie zdjęcie"

#: gpxfoto/engine/writer.py:123
msgid "exiftool did not write the file"
msgstr "program exiftool nie zapisał pliku"

#: gpxfoto/engine/writer.py:125
msgid "exiftool changed the image data; the result was discarded"
msgstr "program exiftool zmienił dane obrazu; wynik odrzucono"

#: gpxfoto/engine/writer.py:219
msgid ""
"This directory holds copies of the photos next to it as they were "
"before gpxfoto added locations to them. gpxfoto never changes or "
"replaces these copies."
msgstr ""
"Ten katalog zawiera kopie znajdujących się obok zdjęć w postaci "
"sprzed dopisania do nich położenia przez program gpxfoto. Program "
"gpxfoto nigdy nie zmienia ani nie zastępuje tych kopii."

#: gpxfoto/engine/writer.py:236
#, python-brace-format
msgid "“{path}” already exists and is not a backup directory of gpxfoto"
msgstr ""
"„{path}” już istnieje i nie jest katalogiem kopii zapasowych programu "
"gpxfoto"

#: gpxfoto/engine/writer.py:260
msgid "the backup copy differs from the photo"
msgstr "kopia zapasowa różni się od zdjęcia"

#: gpxfoto/engine/writer.py:287
#, python-brace-format
msgid "“{path}” already exists and is not a copy of this photo"
msgstr "„{path}” już istnieje i nie jest kopią tego zdjęcia"

#: gpxfoto/i18n.py:45 gpxfoto/i18n.py:77
#, python-brace-format
msgid "{seconds} s"
msgstr "{seconds} s"

#: gpxfoto/i18n.py:47 gpxfoto/i18n.py:75
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} min"

#: gpxfoto/i18n.py:48 gpxfoto/i18n.py:69
#, python-brace-format
msgid "{hours} h {minutes} min"
msgstr "{hours} h {minutes} min"

#: gpxfoto/i18n.py:66
#, python-brace-format
msgid "{hours} h {minutes} min {seconds} s"
msgstr "{hours} h {minutes} min {seconds} s"

#: gpxfoto/i18n.py:71
#, python-brace-format
msgid "{hours} h"
msgstr "{hours} h"

#: gpxfoto/i18n.py:73
#, python-brace-format
msgid "{minutes} min {seconds} s"
msgstr "{minutes} min {seconds} s"
