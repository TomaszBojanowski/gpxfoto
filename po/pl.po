#. Translators: {option} is the command-line option --timezone
#: gpxfoto/cli.py:30
#, python-brace-format
msgid "time zone from {option}"
msgstr "strefa czasowa z opcji {option}"

#: gpxfoto/cli.py:31
msgid "computer’s time zone (not in EXIF)"
msgstr "strefa czasowa komputera (brak w EXIF)"

#. Translators: {option} is the command-line option --timezone
#: gpxfoto/cli.py:38
#, python-brace-format
msgid ""
"Either the time zone given with {option} or the camera’s time zone setting "
"is wrong."
msgstr ""
"Błędna jest strefa czasowa podana w opcji {option} albo ustawienie strefy "
"czasowej w aparacie."

#: gpxfoto/cli.py:40
msgid ""
"EXIF has no time zone, so this computer’s time zone was used; either it or "
"the camera’s time zone setting is wrong."
msgstr ""
"W EXIF brak strefy czasowej, więc użyto strefy czasowej komputera; błędna "
"jest ona albo ustawienie strefy czasowej w aparacie."

#: gpxfoto/cli.py:42
msgid ""
"Another program may have changed the capture time or the time zone in EXIF; "
"the locations follow the time in EXIF."
msgstr ""
"Czas wykonania lub strefa czasowa w EXIF mogły zostać zmienione przez inny "
"program; położenie ustalono według czasu z EXIF."

#: gpxfoto/cli.py:50
msgid "usage: "
msgstr "użycie: "

#: gpxfoto/cli.py:51
#, python-format
msgid "%(heading)s:"
msgstr "%(heading)s:"

#: gpxfoto/cli.py:52
msgid "positional arguments"
msgstr "argumenty pozycyjne"

#: gpxfoto/cli.py:53
msgid "options"
msgstr "opcje"

#: gpxfoto/cli.py:54
msgid "show this help message and exit"
msgstr "wyświetla ten komunikat pomocy i kończy działanie"

#: gpxfoto/cli.py:55
#, python-format
msgid "%(prog)s: error: %(message)s\n"
msgstr "%(prog)s: błąd: %(message)s\n"

#: gpxfoto/cli.py:56
#, python-format
msgid "argument %(argument_name)s: %(message)s"
msgstr "argument %(argument_name)s: %(message)s"

#: gpxfoto/cli.py:57
#, python-format
msgid "the following arguments are required: %s"
msgstr "wymagane są następujące argumenty: %s"

#: gpxfoto/cli.py:58
#, python-format
msgid "unrecognized arguments: %s"
msgstr "nierozpoznane argumenty: %s"

#: gpxfoto/cli.py:59
#, python-format
msgid "ignored explicit argument %r"
msgstr "zignorowano jawnie podany argument %r"

#: gpxfoto/cli.py:60
msgid "expected one argument"
msgstr "oczekiwano jednego argumentu"

#: gpxfoto/cli.py:61
#, python-format
msgid "invalid %(type)s value: %(value)r"
msgstr "nieprawidłowa wartość typu %(type)s: %(value)r"

#: gpxfoto/cli.py:77 gpxfoto/server/session.py:187
#, python-brace-format
msgid "not a valid number of seconds: {value}"
msgstr "nieprawidłowa liczba sekund: {value}"

#: gpxfoto/cli.py:84
#, python-brace-format
msgid "must not be negative: {value}"
msgstr "wartość nie może być ujemna: {value}"

#. Translators: date and time of a track point as a strftime format. %x
#. and %X follow the system's regional settings; replace them only if
#. those are wrong for your language, as they are for Polish on macOS
#. (%-d is the day without a leading zero).
#: gpxfoto/cli.py:109
#, no-python-format
msgid "%x %X"
msgstr "%-d.%m.%Y %H:%M:%S"

#: gpxfoto/cli.py:138
msgid ""
"Adds locations from GPX tracks to photos without changing the image data."
msgstr ""
"Dopisuje do zdjęć położenie na podstawie tras GPX, nie zmieniając danych "
"obrazu."

#. Translators: placeholder for arguments in the usage line of --help;
#. keep it a single word
#: gpxfoto/cli.py:142
msgid "PHOTO"
msgstr "ZDJĘCIE"

#: gpxfoto/cli.py:143
msgid "JPEG files or directories with photos"
msgstr "pliki JPEG lub katalogi ze zdjęciami"

#. Translators: placeholder for a track file or directory in --help; keep
#. it a single word
#: gpxfoto/cli.py:146
msgid "TRACK"
msgstr "TRASA"

#: gpxfoto/cli.py:147
msgid ""
"GPX file with the track, or a directory with GPX files: each photo then gets "
"the track that covers its time (can be given more than once)"
msgstr ""
"plik GPX z trasą lub katalog z plikami GPX; wtedy dla każdego zdjęcia "
"wybierana jest trasa obejmująca czas jego wykonania (można podać "
"wielokrotnie)"

#: gpxfoto/cli.py:151
msgid ""
"write the locations to the files (without this option only a preview is "
"shown)"
msgstr ""
"zapisuje położenie w plikach (bez tej opcji wyświetlany jest tylko podgląd)"

#. Translators: placeholder for a number in --help; keep it a single word
#: gpxfoto/cli.py:154 gpxfoto/cli.py:170
msgid "SECONDS"
msgstr "SEKUNDY"

#: gpxfoto/cli.py:155
msgid "camera clock correction in seconds, added to the capture time"
msgstr ""
"poprawka zegara aparatu w sekundach, dodawana do czasu wykonania zdjęcia"

#. Translators: placeholder in --help; HH stands for hours, MM for minutes
#: gpxfoto/cli.py:157
msgid "+HH:MM"
msgstr "+GG:MM"

#: gpxfoto/cli.py:158
msgid ""
"camera time zone for all photos (default: read from each photo’s EXIF data)"
msgstr ""
"strefa czasowa aparatu dla wszystkich zdjęć (domyślnie: odczytywana z danych "
"EXIF każdego zdjęcia)"

#: gpxfoto/cli.py:160
msgid "FILE"
msgstr "PLIK"

#: gpxfoto/cli.py:161
#, python-brace-format
msgid ""
"photo of an accurate clock, such as the watch that records the track, for "
"working out the camera clock correction (with {option})"
msgstr ""
"zdjęcie dokładnego zegara, na przykład zegarka zapisującego trasę, służące "
"do wyznaczenia poprawki zegara aparatu (razem z opcją {option})"

#. Translators: placeholder for a time in --help; keep it a single word
#: gpxfoto/cli.py:165
msgid "TIME"
msgstr "CZAS"

#: gpxfoto/cli.py:166
#, python-brace-format
msgid ""
"time shown on the clock in the {option} photo, 24-hour, for example "
"14:03:27, 14:03:27+02:00 or 2026-10-06T14:03:27+02:00"
msgstr ""
"czas widoczny na zegarze na zdjęciu podanym w opcji {option}, w formacie 24-"
"godzinnym, na przykład 14:03:27, 14:03:27+02:00 lub 2026-10-06T14:03:27+02:00"

#: gpxfoto/cli.py:171
#, python-brace-format
msgid ""
"largest allowed time between a photo and the nearest track point (default: "
"{seconds} s)"
msgstr ""
"największy dopuszczalny odstęp czasu między zdjęciem a najbliższym punktem "
"trasy (domyślnie: {seconds} s)"

#: gpxfoto/cli.py:174
msgid ""
"do not look for stops; every photo gets the track’s position at its time"
msgstr ""
"nie wyszukuje postojów; każde zdjęcie otrzymuje położenie z trasy w chwili "
"wykonania"

#: gpxfoto/cli.py:177
msgid "also change photos that already have a location"
msgstr "zmienia także zdjęcia, które mają już zapisane położenie"

#: gpxfoto/cli.py:179
msgid ""
"also add the direction of travel from the track (EXIF GPSTrack), not the "
"direction the camera faced; photos taken at a stop or on a winding stretch "
"get none"
msgstr ""
"dopisuje także kierunek ruchu z trasy (EXIF GPSTrack), a nie kierunek, w "
"którym skierowany był aparat; zdjęcia zrobione na postoju lub na krętym "
"odcinku go nie otrzymują"

#: gpxfoto/cli.py:184
#, python-brace-format
msgid ""
"keep copies of the original files in a “{directory}” subdirectory next to "
"each photo; an existing copy is never replaced"
msgstr ""
"zachowuje kopie oryginalnych plików w podkatalogu „{directory}” obok każdego "
"zdjęcia; istniejąca kopia nigdy nie jest zastępowana"

#: gpxfoto/cli.py:188
msgid "also look for photos and tracks in subdirectories"
msgstr "wyszukuje zdjęcia i trasy także w podkatalogach"

#: gpxfoto/cli.py:190
msgid ""
"open the interface in the browser instead, where the photos and tracks are "
"chosen; no other arguments are given then"
msgstr ""
"otwiera zamiast tego interfejs w przeglądarce, w którym wybiera się zdjęcia "
"i trasy; nie podaje się wtedy innych argumentów"

#. Translators: a note on the line of a photo; {zone} is a UTC offset
#. such as +02:00
#: gpxfoto/cli.py:210
#, python-brace-format
msgid "camera’s UTC time suggests {zone}"
msgstr "czas UTC z aparatu wskazuje strefę {zone}"

#. Translators: a note on the line of a photo; {duration} is a time span
#. such as “10 min”
#: gpxfoto/cli.py:214
#, python-brace-format
msgid "differs by {duration} from the camera’s UTC time"
msgstr "różni się o {duration} od czasu UTC z aparatu"

#: gpxfoto/cli.py:228
#, python-brace-format
msgid ""
"Warning: {count} photo has a capture time that does not match the UTC time "
"recorded by the camera."
msgid_plural ""
"Warning: {count} photos have capture times that do not match the UTC time "
"recorded by the camera."
msgstr[0] ""
"Ostrzeżenie: {count} zdjęcie ma czas wykonania niezgodny z czasem UTC "
"zapisanym przez aparat."
msgstr[1] ""
"Ostrzeżenie: {count} zdjęcia mają czas wykonania niezgodny z czasem UTC "
"zapisanym przez aparat."
msgstr[2] ""
"Ostrzeżenie: {count} zdjęć ma czas wykonania niezgodny z czasem UTC "
"zapisanym przez aparat."

#. Translators: {option} is a command-line option with its value,
#. such as --timezone=+02:00
#: gpxfoto/cli.py:238
#, python-brace-format
msgid "Both times would match with {option}."
msgstr "Oba czasy byłyby zgodne przy opcji {option}."

#. Translators: a note on the line of a photo taken during a stop, which
#. gets the stop's position; {start} and {end} are times such as
#. “12:31:05”, with the date when the stop lasts over midnight
#: gpxfoto/cli.py:253 gpxfoto/web/js/main.js:279
#, python-brace-format
msgid "stop {start} – {end}"
msgstr "postój {start} – {end}"

#. Translators: a note on the line of a photo; {reason} says why,
#. e.g. “the track winds too much here”
#: gpxfoto/cli.py:286
#, python-brace-format
msgid "no direction of travel: {reason}"
msgstr "brak kierunku ruchu: {reason}"

#. Translators: shown after the position of a photo; {degrees} is
#. a whole number from 0 to 359, padded to three characters
#: gpxfoto/cli.py:290
#, python-brace-format
msgid "direction of travel {degrees}°"
msgstr "kierunek ruchu {degrees}°"

#. Translators: shown after the file name of a photo; {reason} says
#. why the photo was skipped, e.g. “already has a location”
#: gpxfoto/cli.py:297 gpxfoto/web/js/main.js:289 gpxfoto/web/js/main.js:291
#, python-brace-format
msgid "skipped: {reason}"
msgstr "pominięte: {reason}"

#. Translators: elevation in metres
#: gpxfoto/cli.py:302 gpxfoto/web/js/main.js:303
#, python-brace-format
msgid "{elevation} m"
msgstr "{elevation} m"

#. Translators: {correction} is a time span with a sign, such as
#. “+2 min 12 s”; {option} is the same as a command-line option, such as
#. “--offset=132”
#: gpxfoto/cli.py:314
#, python-brace-format
msgid "Clock correction: {correction} (equivalent to {option})"
msgstr "Poprawka zegara: {correction} (odpowiada opcji {option})"

#. Translators: a UTC offset as shown to the user; {offset} is, for
#. example, “+02:00”
#: gpxfoto/cli.py:321 gpxfoto/cli.py:495 gpxfoto/cli.py:496
#: gpxfoto/server/warnings.py:55 gpxfoto/server/warnings.py:56
#, python-brace-format
msgid "UTC{offset}"
msgstr "UTC{offset}"

#. Translators: {name} is the file name of the clock photo; {camera} and
#. {clock} are the date and time the camera and the clock showed
#: gpxfoto/cli.py:326
#, python-brace-format
msgid "Clock photo {name}: camera {camera}, clock {clock}"
msgstr "Zdjęcie zegara {name}: aparat {camera}, zegar {clock}"

#: gpxfoto/cli.py:333
msgid ""
"The time on the clock was given without seconds, so the middle of the minute "
"was used; the correction may be off by up to 30 s."
msgstr ""
"Czas na zegarze podano bez sekund, więc przyjęto środek minuty; poprawka "
"może się różnić od właściwej o najwyżej 30 s."

#: gpxfoto/cli.py:346
#, python-brace-format
msgid ""
"Track {name}: {count} point, {start} – {end} (this computer’s time zone)"
msgid_plural ""
"Track {name}: {count} points, {start} – {end} (this computer’s time zone)"
msgstr[0] ""
"Trasa {name}: {count} punkt, {start} – {end} (strefa czasowa komputera)"
msgstr[1] ""
"Trasa {name}: {count} punkty, {start} – {end} (strefa czasowa komputera)"
msgstr[2] ""
"Trasa {name}: {count} punktów, {start} – {end} (strefa czasowa komputera)"

#. Translators: {start} and {end} are the date and time of the first and the
#. last track point
#: gpxfoto/cli.py:352
#, python-brace-format
msgid "Track: {count} point, {start} – {end} (this computer’s time zone)"
msgid_plural ""
"Track: {count} points, {start} – {end} (this computer’s time zone)"
msgstr[0] "Trasa: {count} punkt, {start} – {end} (strefa czasowa komputera)"
msgstr[1] "Trasa: {count} punkty, {start} – {end} (strefa czasowa komputera)"
msgstr[2] "Trasa: {count} punktów, {start} – {end} (strefa czasowa komputera)"

#. Translators: {correction} is a time span with a sign, such as
#. “+2 min 12 s”, added to the capture time of every photo
#: gpxfoto/cli.py:367
#, python-brace-format
msgid "Clock correction: {correction}"
msgstr "Poprawka zegara: {correction}"

#: gpxfoto/cli.py:384
msgid "This file is skipped; the other tracks are used."
msgstr "Ten plik zostaje pominięty; używane są pozostałe trasy."

#. Translators: {shift} is a whole number of hours or half an hour with a
#. sign, such as “+1 h” or “-30 min”; {pinned}, {matched} and {now} are
#. numbers of photos
#: gpxfoto/cli.py:400
#, python-brace-format
msgid ""
"Warning: with the photo times shifted by {shift}, clearly more photos fall "
"during stops: {pinned} of {matched} instead of {now}."
msgstr ""
"Ostrzeżenie: po przesunięciu czasu zdjęć o {shift} wyraźnie więcej zdjęć "
"wypada na postojach: {pinned} z {matched} zamiast {now}."

#: gpxfoto/cli.py:406
msgid ""
"A difference of exactly one hour usually means that the camera was not "
"switched to or from summer time, or that its time zone is set wrong."
msgstr ""
"Różnica dokładnie jednej godziny zwykle oznacza, że w aparacie nie "
"przestawiono czasu na letni lub zimowy albo że ustawiono w nim złą strefę "
"czasową."

#: gpxfoto/cli.py:410
msgid ""
"A difference of whole hours or of half an hour usually means that the time "
"zone set in the camera is wrong, for example still the home one while "
"travelling."
msgstr ""
"Różnica wynosząca pełne godziny lub pół godziny zwykle oznacza, że w "
"aparacie ustawiono złą strefę czasową, na przykład wciąż domową podczas "
"podróży."

#. Translators: {option} is a command-line option with its value,
#. such as --offset=3600; {photo} and {time} are the options
#. --clock-photo and --clock-time
#: gpxfoto/cli.py:424
#, python-brace-format
msgid ""
"To apply this correction, run again with {option} instead of {photo} and "
"{time}."
msgstr ""
"Aby zastosować tę poprawkę, należy uruchomić program ponownie z opcją "
"{option} zamiast {photo} i {time}."

#. Translators: {option} is a command-line option with its value, such
#. as --offset=3600
#: gpxfoto/cli.py:441
#, python-brace-format
msgid "To apply this correction, run again with {option}."
msgstr ""
"Aby zastosować tę poprawkę, należy uruchomić program ponownie z opcją "
"{option}."

#. Translators: {option} and {other} are command-line options with
#. their values, such as --offset=3600 and --timezone=+01:00
#: gpxfoto/cli.py:446
#, python-brace-format
msgid "To apply this correction, run again with {option} or {other}."
msgstr ""
"Aby zastosować tę poprawkę, należy uruchomić program ponownie z opcją "
"{option} albo {other}."

#. Translators: {fast} and {matched} are numbers of photos
#: gpxfoto/cli.py:454
#, python-brace-format
msgid ""
"Warning: the camera clock may be off. {fast} of {matched} matched photo was "
"taken while the track shows movement at full pace."
msgid_plural ""
"Warning: the camera clock may be off. {fast} of {matched} matched photos "
"were taken while the track shows movement at full pace."
msgstr[0] ""
"Ostrzeżenie: zegar aparatu może być przesunięty. {fast} z {matched} "
"dopasowanego zdjęcia zrobiono, gdy według trasy poruszano się pełnym tempem."
msgstr[1] ""
"Ostrzeżenie: zegar aparatu może być przesunięty. {fast} z {matched} "
"dopasowanych zdjęć zrobiono, gdy według trasy poruszano się pełnym tempem."
msgstr[2] ""
"Ostrzeżenie: zegar aparatu może być przesunięty. {fast} z {matched} "
"dopasowanych zdjęć zrobiono, gdy według trasy poruszano się pełnym tempem."

#. Translators: {photo} and {time} are the command-line options
#. --clock-photo and --clock-time
#: gpxfoto/cli.py:463
#, python-brace-format
msgid ""
"Photos are usually taken at stops or while slowing down. Check the camera "
"clock, for example with a photo of the watch that records the track and the "
"options {photo} and {time}."
msgstr ""
"Zdjęcia robi się zwykle na postojach albo przy zwalnianiu. Należy sprawdzić "
"zegar aparatu, na przykład za pomocą zdjęcia zegarka, który zapisuje trasę, "
"i opcji {photo} oraz {time}."

#. Translators: {option} is the command-line option --clock-time
#: gpxfoto/cli.py:469
#, python-brace-format
msgid ""
"Photos are usually taken at stops or while slowing down. Check the time on "
"the clock given with {option}, and its UTC offset."
msgstr ""
"Zdjęcia robi się zwykle na postojach albo przy zwalnianiu. Należy sprawdzić "
"czas na zegarze podany w opcji {option} i jego przesunięcie względem UTC."

#: gpxfoto/cli.py:477
msgid ""
"Warning: photos taken less than a minute apart are placed implausibly far "
"apart:"
msgstr ""
"Ostrzeżenie: zdjęcia zrobione w odstępie krótszym niż minuta są umieszczone "
"nieprawdopodobnie daleko od siebie:"

#. Translators: {first} and {second} are file names; {interval} is
#. a time span such as “4 s”; {distance} is a distance such as “1.3 km”
#: gpxfoto/cli.py:488 gpxfoto/server/warnings.py:50
#, python-brace-format
msgid "{first} and {second}: taken {interval} apart, placed {distance} apart"
msgstr ""
"{first} i {second}: zrobione w odstępie {interval}, umieszczone {distance} "
"od siebie"

#. Translators: {first_zone} and {second_zone} are UTC offsets as
#. shown to the user, such as “UTC+02:00”
#: gpxfoto/cli.py:493 gpxfoto/server/warnings.py:53
#, python-brace-format
msgid ""
"{first} and {second}: taken {interval} apart, placed {distance} apart, time "
"zones {first_zone} and {second_zone}"
msgstr ""
"{first} i {second}: zrobione w odstępie {interval}, umieszczone {distance} "
"od siebie, strefy czasowe {first_zone} i {second_zone}"

#: gpxfoto/cli.py:501 gpxfoto/server/warnings.py:68
#, python-brace-format
msgid "and {count} more pair"
msgid_plural "and {count} more pairs"
msgstr[0] "i jeszcze {count} para"
msgstr[1] "i jeszcze {count} pary"
msgstr[2] "i jeszcze {count} par"

#: gpxfoto/cli.py:503 gpxfoto/server/warnings.py:70
msgid ""
"Check the time zones of these photos, and whether the GPX files record "
"different trips at the same time."
msgstr ""
"Należy sprawdzić strefy czasowe tych zdjęć oraz to, czy pliki GPX nie "
"zapisują różnych wycieczek w tym samym czasie."

#. Translators: why a photo gets no direction of travel
#: gpxfoto/cli.py:530
msgid "taken during a stop"
msgstr "zrobione podczas postoju"

#: gpxfoto/cli.py:539 gpxfoto/server/session.py:454
msgid "The GPX file contains no track points with timestamps."
msgid_plural "The GPX files contain no track points with timestamps."
msgstr[0] "Plik GPX nie zawiera punktów trasy ze znacznikami czasu."
msgstr[1] "Pliki GPX nie zawierają punktów trasy ze znacznikami czasu."
msgstr[2] "Pliki GPX nie zawierają punktów trasy ze znacznikami czasu."

#. Translators: {option} and {other} are command-line options
#: gpxfoto/cli.py:554
#, python-brace-format
msgid "{option} must be used together with {other}"
msgstr "opcji {option} należy użyć razem z opcją {other}"

#. Translators: {option} and {other} are command-line options
#: gpxfoto/cli.py:558
#, python-brace-format
msgid "{option} cannot be used together with {other}"
msgstr "opcji {option} nie można użyć razem z opcją {other}"

#: gpxfoto/cli.py:562 gpxfoto/server/ui.py:19
#, python-brace-format
msgid "exiftool is not installed. On Fedora, install it with: {command}"
msgstr ""
"Program exiftool nie jest zainstalowany. W systemie Fedora można go "
"zainstalować poleceniem: {command}"

#: gpxfoto/cli.py:571
msgid "The time zone must be in the form +HH:MM, for example +02:00 or -05:00."
msgstr ""
"Strefę czasową należy podać w postaci +GG:MM, na przykład +02:00 lub -05:00."

#: gpxfoto/cli.py:588 gpxfoto/server/session.py:117
