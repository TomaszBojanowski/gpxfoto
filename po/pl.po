msgstr "Wczytywanie zdjęć: {done} z {total}"

#: gpxfoto/web/js/main.js:231
msgid "Cancelling: finishing the photos being written…"
msgstr "Anulowanie: kończenie zapisu rozpoczętych zdjęć…"

#: gpxfoto/web/js/main.js:233
msgid "Undoing the write: {done} of {total}"
msgstr "Cofanie zapisu: {done} z {total}"

#: gpxfoto/web/js/main.js:235
msgid "Writing locations: {done} of {total}"
msgstr "Zapisywanie położenia: {done} z {total}"

#: gpxfoto/web/js/main.js:273
msgid "will overwrite the existing location"
msgstr "nadpisze istniejące położenie"

#: gpxfoto/web/js/main.js:276
msgid "placed by hand"
msgstr "umieszczone ręcznie"

#: gpxfoto/web/js/main.js:397 gpxfoto/web/js/main.js:405
msgid "Drag the photo on the map to move it."
msgstr "Zdjęcie można przesunąć, przeciągając je na mapie."

#: gpxfoto/web/js/main.js:402
msgid "Use the position from the track"
msgstr "Użyj położenia z trasy"

#: gpxfoto/web/js/main.js:408
msgid "Click on the map where this photo was taken."
msgstr "Należy kliknąć na mapie miejsce, w którym zrobiono to zdjęcie."

#: gpxfoto/web/js/main.js:505
msgid "The map cannot be shown: this browser does not allow WebGL."
msgstr "Nie można wyświetlić mapy: ta przeglądarka nie zezwala na WebGL."

#: gpxfoto/web/js/main.js:581
msgid "All ({count})"
msgstr "Wszystkie ({count})"

#: gpxfoto/web/js/main.js:582
msgid "Matched ({count})"
msgstr "Dopasowane ({count})"

#: gpxfoto/web/js/main.js:583
msgid "Skipped ({count})"
msgstr "Pominięte ({count})"

#: gpxfoto/web/js/main.js:597 gpxfoto/web/js/main.js:833
msgid "Write {count} location"
msgid_plural "Write {count} locations"
msgstr[0] "Zapisz {count} położenie"
msgstr[1] "Zapisz {count} położenia"
msgstr[2] "Zapisz {count} położeń"

#: gpxfoto/web/js/main.js:600
msgid "Undoing…"
msgstr "Cofanie…"

#: gpxfoto/web/js/main.js:600
msgid "Writing…"
msgstr "Zapisywanie…"

#: gpxfoto/web/js/main.js:822
msgid "The location will be written into {count} photo."
msgid_plural "The location will be written into {count} photos."
msgstr[0] "Położenie zostanie zapisane w {count} zdjęciu."
msgstr[1] "Położenie zostanie zapisane w {count} zdjęciach."
msgstr[2] "Położenie zostanie zapisane w {count} zdjęciach."

#: gpxfoto/web/js/main.js:827
msgid "{count} of them already has a location, which will be overwritten."
msgid_plural ""
"{count} of them already have a location, which will be overwritten."
msgstr[0] "{count} z nich ma już położenie, które zostanie nadpisane."
msgstr[1] "{count} z nich mają już położenie, które zostanie nadpisane."
msgstr[2] "{count} z nich ma już położenie, które zostanie nadpisane."

#: gpxfoto/web/js/main.js:831
msgid ""
"Only the location is written. The image data of every photo is checked to be "
"unchanged, and a photo is replaced only once it is."
msgstr ""
"Zapisywane jest wyłącznie położenie. Dane obrazu każdego zdjęcia są "
"sprawdzane, a zdjęcie zostaje zastąpione dopiero po potwierdzeniu, że się "
"nie zmieniły."

#: gpxfoto/web/js/main.js:835
msgid "Write the locations?"
msgstr "Zapisać położenie?"

#: gpxfoto/web/js/main.js:847
msgid ""
"The GPS data of {count} photo will be restored as it was before the last "
"write."
msgid_plural ""
"The GPS data of {count} photos will be restored as they were before the last "
"write."
msgstr[0] ""
"Dane GPS {count} zdjęcia zostaną przywrócone do stanu sprzed ostatniego "
"zapisu."
msgstr[1] ""
"Dane GPS {count} zdjęć zostaną przywrócone do stanu sprzed ostatniego zapisu."
msgstr[2] ""
"Dane GPS {count} zdjęć zostaną przywrócone do stanu sprzed ostatniego zapisu."

#: gpxfoto/web/js/main.js:850
msgid "A photo changed by another program since then is left as it is."
msgstr ""
"Zdjęcie zmienione od tego czasu przez inny program pozostaje bez zmian."

#: gpxfoto/web/js/main.js:851
msgid "Undo the last write?"
msgstr "Cofnąć ostatni zapis?"

#: gpxfoto/web/js/main.js:851
msgid "Undo"
msgstr "Cofnij"

#: gpxfoto/web/js/main.js:867
msgid "Restored: {written}, errors: {errors}"
msgstr "Przywrócono: {written}, błędy: {errors}"

#: gpxfoto/web/js/main.js:873
msgid "Every restored photo is the same, to the byte, as before the write."
msgstr ""
"Każde przywrócone zdjęcie jest identyczne co do bajta jak przed zapisem."

#: gpxfoto/web/js/main.js:878
msgid "{count} photo was not restored, as the undoing was cancelled."
msgid_plural "{count} photos were not restored, as the undoing was cancelled."
msgstr[0] ""
"{count} zdjęcie nie zostało przywrócone, ponieważ anulowano cofanie."
msgstr[1] ""
"{count} zdjęcia nie zostały przywrócone, ponieważ anulowano cofanie."
msgstr[2] ""
"{count} zdjęć nie zostało przywróconych, ponieważ anulowano cofanie."

#: gpxfoto/web/js/main.js:880
msgid "{count} photo was not written, as the writing was cancelled."
msgid_plural "{count} photos were not written, as the writing was cancelled."
msgstr[0] "{count} zdjęcie nie zostało zapisane, ponieważ anulowano zapis."
msgstr[1] "{count} zdjęcia nie zostały zapisane, ponieważ anulowano zapis."
msgstr[2] "{count} zdjęć nie zostało zapisanych, ponieważ anulowano zapis."

#: gpxfoto/web/js/main.js:886
msgid "Could not restore {name}: {error} (file unchanged)"
msgstr "Nie można przywrócić pliku {name}: {error} (plik bez zmian)"

#: gpxfoto/web/js/main.js:896
msgid "Writing cancelled"
msgstr "Anulowano zapis"

#: gpxfoto/web/js/main.js:896
msgid "Writing finished"
msgstr "Ukończono zapis"

#: gpxfoto/web/js/main.js:898
msgid "Undoing cancelled"
msgstr "Anulowano cofanie"

#: gpxfoto/web/js/main.js:898
msgid "Undoing finished"
msgstr "Ukończono cofanie"

#: gpxfoto/web/js/main.js:955
msgid ""
"Only GPX files can be dropped here. Choose the folder with photos with the "
"Photos button."
msgstr ""
"Tutaj można upuścić tylko pliki GPX. Folder ze zdjęciami należy wybrać "
"przyciskiem „Zdjęcia”."

#: gpxfoto/web/js/map.js:123
msgid "Zoom in"
msgstr "Przybliż"

#: gpxfoto/web/js/map.js:124
msgid "Zoom out"
msgstr "Oddal"

#: gpxfoto/web/js/map.js:125
msgid "Show or hide the sources of the map"
msgstr "Pokaż lub ukryj źródła mapy"

#: gpxfoto/web/js/map.js:126
msgid "Map"
msgstr "Mapa"

#: gpxfoto/web/js/map.js:178
msgid "Show the whole track"
msgstr "Pokaż całą trasę"

#: gpxfoto/web/js/map.js:181
msgid "Dark map"
msgstr "Ciemna mapa"

#: gpxfoto/web/js/texts.js:7
msgid "Photos"
msgstr "Zdjęcia"

#: gpxfoto/web/js/texts.js:8
msgid "Choose a folder…"
msgstr "Wybierz folder…"

#: gpxfoto/web/js/texts.js:9
msgid "Track"
msgstr "Trasa"

#: gpxfoto/web/js/texts.js:10
msgid "Choose a GPX file…"
msgstr "Wybierz plik GPX…"

#. Translators: a button that turns on moving photos on the map by hand
#: gpxfoto/web/js/texts.js:12
msgid "Edit locations"
msgstr "Edytuj położenie"

#: gpxfoto/web/js/texts.js:13
msgid "Options"
msgstr "Opcje"

#: gpxfoto/web/js/texts.js:14
msgid "Undo the last write"
msgstr "Cofnij ostatni zapis"

#: gpxfoto/web/js/texts.js:15
msgid "Overwrite existing locations"
msgstr "Nadpisuj istniejące położenie"

#: gpxfoto/web/js/texts.js:16
msgid ""
"Photos that already have a location also get one from the track. Their "
"existing location will be overwritten."
msgstr ""
"Zdjęcia, które mają już zapisane położenie, też dostaną położenie z trasy. "
"Dotychczasowe położenie zostanie nadpisane."

#: gpxfoto/web/js/texts.js:17
msgid "Stops"
msgstr "Postoje"

#: gpxfoto/web/js/texts.js:18
msgid ""
"Photos taken while standing still get the steadier position of the stop."
msgstr ""
"Zdjęcia zrobione podczas postoju otrzymują stabilniejsze położenie postoju."

#: gpxfoto/web/js/texts.js:19
msgid "Choose a folder with photos and a track to start."
msgstr "Aby zacząć, należy wybrać folder ze zdjęciami i trasę."

#: gpxfoto/web/js/texts.js:20
msgid "A GPX file can also be dropped anywhere on this page."
msgstr "Plik GPX można też upuścić w dowolnym miejscu tej strony."

#. Translators: the label of the slider that corrects the camera clock
#: gpxfoto/web/js/texts.js:22
msgid "Time correction"
msgstr "Poprawka czasu"

#. Translators: a button that moves the time correction back by an hour
#: gpxfoto/web/js/texts.js:24
msgid "−1 h"
msgstr "−1 h"

#. Translators: a button that moves the time correction on by an hour
#: gpxfoto/web/js/texts.js:26
msgid "+1 h"
msgstr "+1 h"

#: gpxfoto/web/js/texts.js:27
msgid "Reset"
msgstr "Wyzeruj"

#: gpxfoto/web/js/texts.js:29
msgid "Folder or file"
msgstr "Folder lub plik"

#: gpxfoto/web/js/texts.js:30
msgid "Open"
msgstr "Otwórz"

#: gpxfoto/web/js/texts.js:31
msgid "Include subfolders"
msgstr "Z podfolderami"

#: gpxfoto/web/js/texts.js:32
msgid "Cancel"
msgstr "Anuluj"

#: gpxfoto/web/js/texts.js:33
msgid "Drop the GPX file to use it as the track"
msgstr "Upuszczony plik GPX zostanie użyty jako trasa"
