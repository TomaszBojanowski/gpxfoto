#, python-brace-format
msgid "{seconds} s"
msgstr "{seconds} s"

#: gpxfoto/i18n.py:56 gpxfoto/i18n.py:84
#, python-brace-format
msgid "{minutes} min"
msgstr "{minutes} min"

#: gpxfoto/i18n.py:57 gpxfoto/i18n.py:78
#, python-brace-format
msgid "{hours} h {minutes} min"
msgstr "{hours} h {minutes} min"

#: gpxfoto/i18n.py:75
#, python-brace-format
msgid "{hours} h {minutes} min {seconds} s"
msgstr "{hours} h {minutes} min {seconds} s"

#: gpxfoto/i18n.py:80
#, python-brace-format
msgid "{hours} h"
msgstr "{hours} h"

